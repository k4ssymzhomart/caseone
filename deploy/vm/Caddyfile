# C:\srv\caddy\Caddyfile — one front door for every project on this VM.
# Each project adds its own routes file in C:\srv\caddy\routes\ and never edits another project's file.
# Reload after changes: C:\srv\caddy\caddy.exe reload --config C:\srv\caddy\Caddyfile

{
	storage file_system {
		root C:/srv/caddy/data
	}
}

# If the provider name does not resolve to 93.170.73.222, replace it with 93-170-73-222.sslip.io
vds39302.vpsza500.kz {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file C:/srv/caddy/logs/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	import C:/srv/caddy/routes/*.caddy
}
