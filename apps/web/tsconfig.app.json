{
  // The panel and every shared source it imports (@rota/shared, @rota/design) are checked with the repo's strict
  // base: verbatimModuleSyntax, erasableSyntaxOnly, noUncheckedIndexedAccess and the unused checks.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "moduleDetection": "force",
    "noEmit": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
