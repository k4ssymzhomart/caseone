{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // Web standard globals only (fetch, Request, Response, AbortController, TextEncoder):
    // the same files run in Edge Functions (Deno), Node scripts (tsx) and vitest.
    "lib": ["es2023", "dom"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": []
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
