# Copy to .env.local (git ignored). Public values only: these ship inside the bundle.
# mock: MockApi in this browser (localStorage); supabase: the real project.
VITE_API_MODE=mock
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Demo account chips on the login page (мастер 1001, руководитель 3001, админ 9001). Set false to hide them.
VITE_DEMO_ACCOUNTS=true
